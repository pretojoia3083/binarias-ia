# Copie para .env (local) ou cadastre no Railway como variaveis
# NUNCA comite esse arquivo

MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxx.mongodb.net
MONGO_DB=binarias_ia

OPENAI_API_KEY=sk-...

# Login da corretora (tambem pode configurar pelo painel)
EXNOVA_EMAIL=seu@email.com
EXNOVA_PASS=sua_senha
EXNOVA_ACCOUNT=PRACTICE

# URL do painel na Vercel (o worker avisa batida por ela)
SITE_URL=https://seu-painel.vercel.app