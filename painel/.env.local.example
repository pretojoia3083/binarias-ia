# Copie para .env.local (local) ou cadastre na Vercel
# NUNCA comite esse arquivo

# MESMO MongoDB do worker
MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxx.mongodb.net
MONGO_DB=binarias_ia

# Senha para entrar no painel
PANEL_PASSWORD=sua_senha_forte

# String aleatoria para o cookie de sessao
PANEL_TOKEN=gere_uma_string_aleatoria_longa_aqui

# URL do proprio painel (o worker manda batida por aqui)
SITE_URL=http://localhost:3000